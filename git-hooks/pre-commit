#!/bin/bash
#
# Git pre-commit hook for Spotless auto-formatting
# 自动格式化暂存的文件
#

echo "Running Spotless auto-format on staged files..."

# 获取所有暂存的 Java, Kotlin, YAML, XML 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(java|gradle\.kts|yml|yaml|xml)$')

if [ -z "$STAGED_FILES" ]; then
  echo "No Java/Kotlin/YAML/XML files staged. Skipping Spotless check."
  exit 0
fi

echo "Staged files to format:"
echo "$STAGED_FILES"

# 运行 spotlessApply 来格式化代码
./gradlew spotlessApply --quiet

# 检查 spotlessApply 是否成功
if [ $? -ne 0 ]; then
  echo "❌ Spotless formatting failed. Please fix the errors and try again."
  exit 1
fi

# 重新添加格式化后的文件到暂存区
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ Spotless formatting completed successfully!"
exit 0
